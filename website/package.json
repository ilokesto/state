{
  "name": "@ilokesto/state-website",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node ../scripts/docs-publication.mjs generate && node ../scripts/docs-runtime.mjs verify && next build",
    "dev": "node ../scripts/docs-publication.mjs generate && node ../scripts/docs-runtime.mjs verify && next dev",
    "start": "next start",
    "typecheck": "node ../scripts/docs-publication.mjs generate && node ../scripts/docs-runtime.mjs verify && fumadocs-mdx && next typegen && tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "postinstall": "node ../scripts/docs-publication.mjs generate && fumadocs-mdx"
  },
  "dependencies": {
    "@ilokesto/state": "workspace:*",
    "@takumi-rs/image-response": "0.73.1",
    "flexsearch": "0.8.212",
    "fumadocs-core": "16.7.6",
    "fumadocs-mdx": "14.2.11",
    "fumadocs-ui": "16.7.6",
    "lucide-react": "1.41.0",
    "next": "16.2.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "3.6.0",
    "@ilokesto/state-docs-runtime": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/mdx": "2.0.14",
    "@types/node": "25.9.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "postcss": "8.5.26",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3"
  }
}
