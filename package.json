{
  "name": "@ilokesto/state",
  "version": "2.0.1",
  "engines": {
    "node": ">=24.22.1"
  },
  "scripts": {
    "build": "rm -rf dist && tsc",
    "test": "pnpm build && pnpm test:unit && pnpm test:types && pnpm test:tooling && pnpm test:browser",
    "test:unit": "bun test tests/unit/",
    "test:browser": "node --test tests/browser/*.browser.mjs",
    "test:types": "tsc --noEmit -p tests/tsconfig.json",
    "test:tooling": "node --test --test-concurrency=2 tests/tooling/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "benchmark": "pnpm build && node scripts/benchmark.mjs",
    "release:verify": "node scripts/release-verify.mjs",
    "changeset": "changeset",
    "changeset:status": "changeset status",
    "version-packages": "changeset version && pnpm install --lockfile-only"
  },
  "packageManager": "pnpm@10.17.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ilokesto/state.git"
  },
  "homepage": "https://github.com/ilokesto/state#readme",
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "module": "dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "default": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./adaptor": {
      "import": "./dist/utils/adaptor.js",
      "default": "./dist/utils/adaptor.js",
      "types": "./dist/utils/adaptor.d.ts"
    },
    "./react": {
      "import": "./dist/core/React/index.js",
      "default": "./dist/core/React/index.js",
      "types": "./dist/core/React/index.d.ts"
    },
    "./vue": {
      "import": "./dist/core/Vue/index.js",
      "default": "./dist/core/Vue/index.js",
      "types": "./dist/core/Vue/index.d.ts"
    },
    "./angular": {
      "import": "./dist/core/Angular/index.js",
      "default": "./dist/core/Angular/index.js",
      "types": "./dist/core/Angular/index.d.ts"
    },
    "./svelte": {
      "import": "./dist/core/Svelte/index.js",
      "default": "./dist/core/Svelte/index.js",
      "types": "./dist/core/Svelte/index.d.ts"
    },
    "./solid": {
      "import": "./dist/core/Solid/index.js",
      "default": "./dist/core/Solid/index.js",
      "types": "./dist/core/Solid/index.d.ts"
    },
    "./middleware": {
      "import": "./dist/middleware/index.js",
      "default": "./dist/middleware/index.js",
      "types": "./dist/middleware/index.d.ts"
    },
    "./utils": {
      "import": "./dist/utils/index.js",
      "default": "./dist/utils/index.js",
      "types": "./dist/utils/index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "state management",
    "react",
    "vue",
    "angular",
    "svelte",
    "solid",
    "store",
    "hooks",
    "state"
  ],
  "publishConfig": {
    "access": "public"
  },
  "author": "Jeong Jinho <wpfekdml@me.com>",
  "license": "MIT",
  "dependencies": {
    "@ilokesto/store": "^2.1.0"
  },
  "peerDependencies": {
    "@angular/core": "^17.0.0 || ^18.0.0 || ^19.0.0 || ^20.0.0 || ^21.0.0",
    "immer": "^9.0.12",
    "react": "^18.0.0 || ^19.0.0",
    "solid-js": "^1.7.0 || ^2.0.0",
    "svelte": "^4.0.0 || ^5.0.0",
    "vue": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "@angular/core": {
      "optional": true
    },
    "immer": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    },
    "svelte": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@angular/core": "^21.2.8",
    "@changesets/cli": "2.31.1",
    "@playwright/test": "^1.61.1",
    "@tanstack/query-core": "5.104.5",
    "@types/bun": "^1.3.14",
    "@types/node": "^22.19.1",
    "@types/react": "^19.1.6",
    "immer": "^9.0.12",
    "react": "19.2.8",
    "solid-js": "^1.9.12",
    "svelte": "^5.55.3",
    "typescript": "^6.0.2",
    "vue": "^3.5.32",
    "xstate": "5.33.3",
    "yaml": "2.8.2",
    "react-dom": "19.2.8"
  }
}
